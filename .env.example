# Hermes 自我進化 Agent —— 環境設定範本
#
#     cp .env.example .env
#
# 這個檔案裡只有一個變數是「非填不可」的：HERMES_DASHBOARD_BASIC_AUTH_PASSWORD。
# 其他都有合理預設值。

# ===========================================================================
# 實例識別（同一台機器上可以跑多個各自獨立的 Hermes agent）
# ===========================================================================
#
# 所有容器名、卷名、網路名、以及 compose 專案名稱都由這個值推導。要跑第二套
# 完全獨立的 agent：複製整個目錄，把 INSTANCE 改掉，再把下面所有埠號改掉。
#
# controller 的孤兒容器回收器會依 hermes.instance 這個 label 過濾，所以兩套
# stack 並存時不會互相砍掉對方正在跑的沙箱。
#
# 限制：只能用小寫英數與 - _（Docker compose 專案名稱的規定）。
INSTANCE=default

# ===========================================================================
# 映像版本
# ===========================================================================
#
# 上游 hermes-agent 的版本。預設釘住而不用 latest —— 自我進化的 agent 已經
# 有夠多變動來源了，底層 runtime 不該是其中之一。
#
# 要更新到最新版：
#     make update-check          # 列出上游最近發佈的標籤
#     $EDITOR .env               # 把 HERMES_VERSION 改成想要的標籤
#     make update                # 重新建置（--pull）並滾動重啟
#
# 也可以直接填 latest，那樣每次 make update 都會跟到上游最新的映像。技能、
# 設定與任務資料庫都在具名卷裡，更新不會動到它們；要退回舊版就把版本號改
# 回去再 make update 一次。
HERMES_VERSION=v2026.7.20

# ===========================================================================
# 使用者對應
# ===========================================================================
#
# 容器內寫出來的檔案在宿主機上的擁有者。這套 stack 預設沒有掛任何宿主機
# 資料夾，所以這組值影響的主要是具名卷裡的檔案；日後真的掛了宿主機目錄，
# 設成你自己的 UID/GID 才不會寫出一堆 root 所有的檔案：
#
#     echo "HERMES_UID=$(id -u)" >> .env
#     echo "HERMES_GID=$(id -g)" >> .env
#
# runtime 與 controller 必須用同一組值 —— controller 晉升出來的技能檔案得讓
# runtime 讀得到。
HERMES_UID=10000
HERMES_GID=10000

# ===========================================================================
# Dashboard（可從遠端連接）
# ===========================================================================
#
# ⚠️ 密碼是必填的。上游在 2026 年 6 月的安全強化之後，只要 dashboard 綁的
#    不是 loopback，就強制要求一個 auth provider，否則 fail closed（所有路由
#    都回錯誤）。HERMES_DASHBOARD_INSECURE 已經是個沒有作用的舊變數。
#
#    產生一組強密碼：
#        openssl rand -base64 24
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# 宿主機上的綁定位址與埠。
# 只想讓本機連的話改成 127.0.0.1，再用 SSH tunnel 進來。
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=9119

# ===========================================================================
# 外部資料夾
# ===========================================================================
#
# 這裡刻意什麼都沒有。**這套 stack 不掛任何宿主機資料夾** —— agent 碰得到的
# 檔案只有具名卷裡的東西。那不是靠政策設定擋下來的，是掛載點根本不存在，
# 所以就算 agent 拿到 terminal、就算進化出來的程式碼想繞，都讀不到你的檔案。
#
# 需要開放某個資料夾時，見 README 的「需要外部資料夾時：讓 hermes 自己裝一個
# MCP filesystem server」。那條路徑會由 hermes 產出一個獨立容器的建置檔與
# compose overlay，你在宿主機上看過、確認掛的是哪個目錄之後才啟用 ——
# 決定「哪個目錄被開放」的永遠是你，不是 agent。

# agent 原生 write_file / patch 工具的可寫範圍（以 : 分隔）。維持上游預設的
# 資料卷就好 —— 這個容器裡本來就只有資料卷，加別的路徑進來也變不出檔案。
HERMES_WRITE_SAFE_ROOT=/opt/data

# ===========================================================================
# 推論後端
# ===========================================================================
#
# ⚠️ 模型與 base_url 是設定在 /opt/data/config.yaml，不是環境變數。
#    第一次啟動前先跑 `make seed-config` 種一份範本進資料卷，再依實際情況
#    修改。目前有兩份範本：
#
#        make seed-config                             # 地端 vLLM（預設）
#        make seed-config TEMPLATE=config.vertex.yaml # Vertex AI / GCP
#
#    詳見 README 的「外接地端 vLLM」與「用 Vertex AI（GCP）當推論後端」。
#
# 這裡的金鑰只在用雲端供應商時才需要。純本地 vLLM 不需要填任何一項
# （config.yaml 裡設 api_key: "none"）。Vertex 也不用 —— 它走 OAuth2，見下一段。
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ===========================================================================
# Vertex AI / GCP（選用）
# ===========================================================================
#
# 不用 Vertex 的話整段留著別動就好 —— 憑證檔不存在時 hermes 會直接跳過，
# 不會報錯也不影響其他 provider。
#
# Vertex 不用靜態 API key，用 GCP service account 換短效的 OAuth2 token。
# 所以這裡設定的是「憑證檔在哪」，不是金鑰本身。
#
# ⚠️ 給這個 service account 的權限請壓到最小 —— 單一專案 + roles/aiplatform.user。
#    憑證是以唯讀掛進 runtime 的，而 agent 讀得到它掛得到的任何檔案（上游的
#    敏感路徑規則只擋寫入，不擋讀取）。詳見 README 的「誠實揭露的殘留風險」。

# 宿主機上存放憑證的目錄，會以 :ro 掛到容器內的 /opt/gcp。
GCP_CREDS_DIR=./secrets

# 上面那個目錄裡的 service account JSON 檔名。
VERTEX_SA_FILE=gcp-sa.json

# 這兩項會蓋掉 config.yaml 的 vertex: 區塊。留空就以 config.yaml 為準
# （project_id 留空 → 用 JSON 內嵌的專案；region 留空 → global）。
VERTEX_PROJECT_ID=
VERTEX_REGION=

# ===========================================================================
# 沙箱資源上限
# ===========================================================================
#
# 每個進化任務起一個獨立容器，跑完強制移除。這些是單一容器的上限。
#
# 記憶體不設 swap（memswap 等於 mem_limit）—— 超出上限直接 OOM kill，比讓它
# 在 swap 上拖到逾時好判讀。
SANDBOX_TIMEOUT_SEC=900
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=2.0
SANDBOX_PIDS_LIMIT=512

# 同時可以有幾個進化任務在跑。乘上 SANDBOX_MEMORY_MB 就是最壞情況的記憶體
# 用量，別設得比機器扛得住的還高。
MAX_CONCURRENT_TASKS=2

# 孤兒沙箱容器的回收間隔（秒）。正常路徑上 controller 會在 finally 裡明確
# 移除容器；這個回收器兜底的是「controller 自己被 SIGKILL」的情況。
REAPER_INTERVAL_SEC=120

# 允許任務要求「以 root 起沙箱」，讓 apt-get install 裝得動系統套件。
#
# 預設關閉。沙箱平常是 uid 10001 + cap_drop ALL，那個組合連 apt 都跑不起來
# （dpkg 改不了 /var/lib/dpkg，症狀是 "Unable to locate package"）。開啟之後，
# 在 /evolve 的請求裡帶 "privileged_install": true 的任務會改成 root + 六個
# 檔案權限相關的 capability（CHOWN DAC_OVERRIDE FOWNER FSETID SETUID SETGID），
# 沒帶的任務完全不受影響。
#
# 這個開關「只」影響短暫的沙箱容器：它依然沒有 CAP_SYS_ADMIN、依然掛著
# no-new-privileges、依然吃記憶體與逾時上限、跑完一定被強制移除。runtime
# 永遠不會拿到 root，agent 在正式容器裡照樣裝不了任何東西。
#
# 為什麼是營運端的開關而不是任務自己說了算：/evolve 沒有身分驗證（邊界是
# 網路拓撲），所以「能不能用 root」這件事不能只由請求內容決定。
#
# 沙箱裝了什麼會被記成待審清單，用 make deps-list 看，make deps-accept 併進
# runtime/deps/*.txt —— 中間隔著一次 git commit。見 README 的
# 「讓 agent 自由裝套件，確認後再進 runtime」。
SANDBOX_ALLOW_PRIVILEGED_INSTALL=0

# ===========================================================================
# 技能晉升
# ===========================================================================
#
# 每個技能保留幾個歷史版本供回滾。
KEEP_VERSIONS=5

# 靜態安全掃描。設成 0 會變成「只記錄不阻擋」—— 只該在調校 policy.yaml 的
# 時候暫時關掉。
#
# ⚠️ 這一層是縱深防禦，不是沙箱。有決心的對手可以繞過任何 denylist。
#    真正的隔離邊界是 sandbox 容器本身。
SCANNER_ENFORCE=1

# ===========================================================================
# 其他
# ===========================================================================
DOCKER_API_TIMEOUT=60
LOG_LEVEL=INFO
